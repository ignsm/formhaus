{
  "name": "rules",
  "definition": {
    "id": "rules",
    "title": "Rules",
    "submit": {
      "label": "Submit"
    },
    "fields": [
      {
        "key": "password",
        "type": "password",
        "label": "Password",
        "validation": {
          "required": true,
          "minLength": 8
        }
      },
      {
        "key": "confirm",
        "type": "password",
        "label": "Confirm",
        "validation": {
          "matchField": "password",
          "matchFieldMessage": "Passwords must match"
        }
      },
      {
        "key": "code",
        "type": "text",
        "label": "Code",
        "validation": {
          "pattern": "^[A-Z]{3}$",
          "patternMessage": "Use three capital letters"
        }
      },
      {
        "key": "nickname",
        "type": "text",
        "label": "Nickname",
        "validation": {
          "maxLength": 5,
          "pattern": "^[a-z]+$"
        }
      }
    ]
  },
  "cases": [
    {
      "name": "accepts matching fields and patterns",
      "input": {
        "values": {
          "password": "secret123",
          "confirm": "secret123",
          "code": "ABC",
          "nickname": "ada"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "password": "secret123",
          "confirm": "secret123",
          "code": "ABC",
          "nickname": "ada"
        },
        "errors": {}
      }
    },
    {
      "name": "rejects a mismatch and a pattern",
      "input": {
        "values": {
          "password": "secret123",
          "confirm": "secret124",
          "code": "abc"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "password": "secret123",
          "confirm": "secret124",
          "code": "abc"
        },
        "errors": {
          "confirm": "Passwords must match",
          "code": "Use three capital letters"
        }
      }
    },
    {
      "name": "rejects a string over maxLength before the pattern runs",
      "input": {
        "values": {
          "password": "secret123",
          "nickname": "ABCDEFG"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "password": "secret123",
          "nickname": "ABCDEFG"
        },
        "errors": {
          "nickname": "Must be at most 5 characters"
        }
      }
    },
    {
      "name": "rejects a string over 10000 characters before the pattern runs",
      "input": {
        "values": {
          "password": "secret123",
          "code": ""
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "password": "secret123",
          "code": ""
        },
        "errors": {
          "code": "Must be at most 10000 characters"
        }
      }
    }
  ]
}
