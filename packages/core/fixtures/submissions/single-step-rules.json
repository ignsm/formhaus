{
  "name": "single-step-rules",
  "definition": {
    "id": "contact",
    "title": "Contact",
    "submit": {
      "label": "Submit"
    },
    "fields": [
      {
        "key": "name",
        "type": "text",
        "label": "Name",
        "validation": {
          "required": true,
          "minLength": 2
        }
      },
      {
        "key": "email",
        "type": "email",
        "label": "Email",
        "validation": {
          "required": true
        }
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "validation": {
          "min": 18
        }
      },
      {
        "key": "subscribe",
        "type": "checkbox",
        "label": "Subscribe"
      }
    ]
  },
  "input": {
    "values": {
      "name": "A",
      "age": 12,
      "subscribe": false
    },
    "skippedSteps": []
  },
  "expected": {
    "values": {
      "name": "A",
      "age": 12,
      "subscribe": false
    },
    "errors": {
      "name": "Must be at least 2 characters",
      "email": "This field is required",
      "age": "Must be at least 18"
    }
  }
}
