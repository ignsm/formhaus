{
  "$schema": "https://formhaus.dev/schema/form-definition.json",
  "id": "onboarding",
  "title": "Set up your workspace",
  "submit": { "label": "Create workspace" },
  "steps": [
    {
      "id": "use",
      "title": "Who is the workspace for?",
      "fields": [
        {
          "key": "use", "type": "radio", "label": "Workspace type",
          "validation": { "required": true },
          "options": [
            { "value": "team", "label": "My team" },
            { "value": "solo", "label": "Just me" }
          ]
        }
      ],
      "routes": [
        {
          "to": "team",
          "show": [{ "field": "use", "eq": "team" }]
        },
        { "to": "solo" }
      ]
    },
    {
      "id": "team",
      "title": "Tell us about your team",
      "fields": [
        {
          "key": "company", "type": "text", "label": "Company",
          "placeholder": "Acme Inc.",
          "validation": { "required": true }
        },
        {
          "key": "size", "type": "radio", "label": "Team size",
          "validation": { "required": true },
          "options": [
            { "value": "2-10", "label": "2–10" },
            { "value": "11-50", "label": "11–50" },
            { "value": "51+", "label": "51+" }
          ]
        }
      ],
      "routes": [{ "to": "finish" }]
    },
    {
      "id": "solo",
      "title": "What will you build with?",
      "fields": [
        {
          "key": "stack", "type": "radio", "label": "Framework",
          "validation": { "required": true },
          "options": [
            { "value": "react", "label": "React" },
            { "value": "vue", "label": "Vue" },
            { "value": "other", "label": "Other" }
          ]
        }
      ],
      "routes": [{ "to": "finish" }]
    },
    {
      "id": "finish",
      "title": "Where should we send the invite?",
      "fields": [
        {
          "key": "email", "type": "email", "label": "Work email",
          "placeholder": "you@company.com",
          "validation": { "required": true }
        }
      ]
    }
  ]
}
